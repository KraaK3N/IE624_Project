# LLM provider: ollama (local Llama) | anthropic (Claude) | openai (ChatGPT) | gemini (Google)
LLM_PROVIDER=ollama
MODEL_NAME=llama3.1:8b
OLLAMA_HOST=http://localhost:11434
# To use a hosted provider, replace the LLM_PROVIDER and MODEL_NAME above
# and set its API key.
# LLM_PROVIDER=anthropic
# MODEL_NAME=claude-haiku-5-5
# ANTHROPIC_API_KEY=
# LLM_PROVIDER=openai
# MODEL_NAME=gpt-5-mini
# OPENAI_API_KEY=
# LLM_PROVIDER=gemini
# MODEL_NAME=gemini-3.8-flash
# GEMINI_API_KEY=

# Answering
TOP_K=5
MIN_RERANK_SCORE=0.2

# Retrieval (the embedding model is read from the Chroma collection built by scripts/index.py)
VECTOR_STORE_PATH=./data/processed/chroma_db
CHUNKS_PATH=./data/processed/chunks.jsonl
COLLECTION_NAME=syscon
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# Faster on CPU, slightly less accurate:
# RERANKER_MODEL=BAAI/bge-reranker-base
DEVICE=
